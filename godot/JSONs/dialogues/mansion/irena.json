    "#reden2": {
        "actors": ["avatar", "irena.r"],
        "text": [
            "irena.r#Papa ist der Größte! Und Mert ist der Größte. Nur Mert ist natürlich nicht Papa.",
            "irena.r#Ich darf jetzt auf Momo aufpassen, wenn Mert weg ist.",
            "irena.r#Momo ist so süß! Ich hoffe, dass ich sie zum Schnurren kriege, wenn sie sich an mich gewöhnt hat.",
            "irena.r#Streicheln kann ich sie schon!",
            "irena.r#Aber versuchs besser nicht, sie kriegt ganz schnell Angst bei Erwachsenen."
        ]
    },
    "#reden3": {
        "actors": ["avatar", "irena.r"],
        "text": [
            "irena.r#Mmmmnh. Ich hab zu tun.",
            "irena.r#Der Weltraum erobert sich nicht von alleine!"
