			"friedel",
			"gerhard.r"
		],
		"text": [
			"avatar#Lass uns reden! Wie geht es Friedel?",
			"gerhard.r#Manchmal glaube ich, er spürt, dass wir uns in einer Krise befinden.",
			"gerhard.r#Wenn er am Fenster liegt und traurig nach draußen schaut. Oder wenn er anhänglicher wird als sonst.",
			"gerhard.r#Aber am nächsten Tag tollt er wieder durch den Park, ohne eine Sorge im Leben ... also vielleicht doch nicht.",
			"avatar#Hund müsste man sein ...",
			"friedel#Wuff!"
		]
	},
	"#reden3": {
		"actors": [
			"avatar",
			"friedel",
			"gerhard.r"
		],
		"text": [
			"avatar#Lass uns reden! Was macht die Gartenarbeit?",
			"gerhard.r#Arbeit? So würde ich das nicht nennen.",
			"gerhard.r#Der Garten war immer mein Rückzugsort nach der Arbeit.",
			"gerhard.r#Und heute ist er mein ganzer Stolz.",
			"friedel#Wuff?",
			"gerhard.r#Zusammen mit Friedel, natürlich.",
			"friedel#Wuff!"
		]
	},
