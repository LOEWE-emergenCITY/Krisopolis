	"stage": {
		"type": "condition",
		"if": {
			"type": "multi",
			"acc": "and",
			"actions": [
				{
					"type": "single",
					"system": "OSM",
					"method": "has_not_flag",
					"params": ["NoEntry", "$result.stage"]
				},
				{
					"type": "single",
					"system": "OSM",
					"method": "has_not_flag",
					"params": ["NoEntry", "all"]
				}
			]
		},
		"then": {
			"type": "condition",
			"if": {
				"type": "single",
				"system": "ActCond",
				"method": "is_current_stage",
				"params": ["home"]
			},
			"then": {
				"type": "single",
				"system": "gui_mngr",
				"method": "request_gui",
				"params": [
					"DefaultActionGUI",
					["$result.question", "$result.stage_act", "SFX_Stage"]
				]
			},
			"else": {
				"type": "single",
				"system": "gui_mngr",
				"method": "request_gui",
				"params": [
					"DefaultActionGUI",
					[
						"$result.question",
						"$result.stage_act_wait",
						"SFX_Stage",
						true,
						"Hat Marktplatz besucht."
					]
				]
			}
		},
		"else": {
			"type": "single",
			"system": "gui_mngr",
			"method": "request_gui",
			"params": ["TooltipGUI", ["$result.no_entry"]]
		}
