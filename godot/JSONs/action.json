	"INT_SINK": {
		"type": "condition",
		"if": {
			"type": "single",
			"system": "OSM",
			"method": "is_effective_state_gt",
			"params": ["WaterState", "NONE"]
		},
		"then": {
			"type": "condition",
			"if": {
				"type": "single",
				"system": "OSM",
				"method": "is_effective_state_eq",
				"params": ["WaterState", "CLEAN"]
			},
			"then": {
				"type": "condition",
				"if": {
					"type": "single",
					"system": "OSM",
					"method": "has_upgrade",
					"params": [6]
				},
				"then": {
					"type": "single",
					"system": "gui_mngr",
					"method": "request_gui",
					"params": [
						"TwoChoice",
						[
							"Willst du Wasser in eine Flasche oder ins Reservoir abfüllen?",
							{
								"text": "Reservoir",
								"time": true,
								"descr": "Wasser ins Reservoir gefüllt.",
								"action": "Fill_Reservoir",
								"sound": "SFX_Water"
							},
							{
								"text": "Flasche",
								"time": false,
								"action": "IQ_Water",
								"sound": "SFX_Water"
							}
						]
					]
				},
				"else": {
					"type": "single",
					"system": "gui_mngr",
					"method": "request_gui",
					"params": [
						"DefaultActionGUI",
						[
							"Willst du Wasser in eine Flasche abfüllen?",
							"IQ_Water",
							"SFX_Water"
						]
					]
				}
			},
			"else": {
				"type": "single",
				"system": "gui_mngr",
				"method": "request_gui",
				"params": [
					"DefaultActionGUI",
					[
						"Das Wasser ist verdreckt. Sicher, dass du es in eine Flasche abfüllen willst?",
						"IQ_DirtyWater",
						"SFX_Water"
					]
				]
			}
		},
		"else": {
			"type": "single",
			"system": "gui_mngr",
			"method": "request_gui",
			"params": ["TooltipGUI", ["Es kommt kein Wasser aus dem Wasserhahn!"]]
